############################################################
# SPARK Project (.gitignore)
# - Keep repository lightweight (no datasets/checkpoints/wandb)
# - Track code + READMEs + job scripts
# - Track only clean SLURM logs (optional, controlled)
# - Track only final submission artifacts you explicitly want
############################################################

############################
# CRITICAL: DO NOT TRACK (large / local-only)
############################
data/
checkpoints/
wandb/
logs/
inference_results/

############################
# OPTIONAL: allow SLURM logs only (if you want examples tracked)
# (Uncomment the block below if you actually want to track slurm out/err)
############################
# !logs/
# !logs/**/
# !logs/**/slurm/
# !logs/**/slurm/*.out
# !logs/**/slurm/*.err

############################
# Inference outputs: keep only final artifacts if needed
# (Uncomment what you want to keep tracked)
############################
# !inference_results/**/submission*.zip
# !inference_results/**/detection.csv
# !inference_results/**/detection_test_predictions.json
# !inference_results/**/segmentation/final/submission_segmentation.zip

############################
# Reports: keep code, ignore generated outputs
############################
reports/latest/
reports/outputs/
reports/figures/
reports/tables/

############################
# Python
############################
**/__pycache__/
*.py[cod]
*.so

############################
# Model weights / large binaries
############################
*.pth
*.pt
*.ckpt

############################
# Archives / large files
############################
*.zip
*.npz
*.tar
*.tar.gz
*.tgz

############################
# Jupyter
############################
.ipynb_checkpoints/
*.ipynb~

############################
# Environments
############################
venv/
.env/
.venv/
conda-env/
env/

############################
# Editors / OS
############################
.vscode/
.DS_Store
*~

############################
# Temp / cache
############################
.cache/
*.log
*.tmp
tmp*/
*_tmp*/
