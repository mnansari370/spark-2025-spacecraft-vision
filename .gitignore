############################
# CRITICAL: DO NOT TRACK
############################

# Datasets (large, not shareable)
data/

# Training outputs
checkpoints/
*.pt
*.ckpt

# ===== Logs (track only SLURM outputs) =====
# Ignore everything under logs by default:
logs/**

# But keep the folder structure:
!logs/
!logs/**/
!logs/**/slurm/
!logs/**/slurm/*.out
!logs/**/slurm/*.err


wandb/

############################
# SUBMISSIONS & ARTIFACTS
############################

# Generated submission files
*.zip
*.npz

# Inference caches / visuals (optional safety)
inference_results/**/visuals_per_class/

############################
# PYTHON
############################

__pycache__/
*.py[cod]
*.so

# Virtual environments
venv/
.env/
.venv/
conda-env/
env/

############################
# JUPYTER
############################

.ipynb_checkpoints/
*.ipynb~

############################
# HPC / SLURM
############################

slurm-*.out
slurm-*.err
*.err

# Allow SLURM logs even though *.out is ignored globally
!logs/**/slurm/*.out
!logs/**/slurm/*.err

############################
# EDITORS / OS
############################

# VS Code
.vscode/

# macOS
.DS_Store

# Linux
*~

############################
# TEMP / CACHE
############################

*.log
*.tmp
.cache/
