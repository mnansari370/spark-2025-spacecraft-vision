############################
# SPARK PROJECT — .gitignore
############################

# --------------------------
# 1) Large local-only folders
# --------------------------
data/
checkpoints/
wandb/
inference_results/
logs/

# Keep directory placeholders (optional)
!data/.gitkeep
!checkpoints/.gitkeep
!wandb/.gitkeep
!inference_results/.gitkeep
!logs/.gitkeep

# --------------------------
# 2) Logs: keep ONLY SLURM out/err
# --------------------------
# (logs/ is ignored above, so we re-allow just slurm logs)
!logs/**/slurm/
!logs/**/slurm/*.out
!logs/**/slurm/*.err

# --------------------------
# 3) Reports: keep code + README, keep latest/ folder structure only
# --------------------------
# Track reports code and docs
!reports/
!reports/README.md
!reports/scripts/**

# Keep reports/latest folder structure in git (with .gitkeep)
!reports/latest/
!reports/latest/.gitkeep
!reports/latest/figures/.gitkeep
!reports/latest/tables/.gitkeep

# But ignore actual generated files inside latest by default
reports/latest/figures/*
reports/latest/tables/*
!reports/latest/figures/.gitkeep
!reports/latest/tables/.gitkeep

# --------------------------
# 4) Python cache / builds
# --------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/

# --------------------------
# 5) Jupyter
# --------------------------
.ipynb_checkpoints/
*.ipynb~

# --------------------------
# 6) Editors / OS junk
# --------------------------
.vscode/
.DS_Store
*~
*.swp
